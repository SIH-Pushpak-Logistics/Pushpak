# Pushpak isolated test LAN. Source this file from bash/zsh.
PUSHPAK_SUBNET=192.168.8.0/24
PUSHPAK_GATEWAY=192.168.8.1
PUSHPAK_GROUND_IP=192.168.8.10
PUSHPAK_SCOUT_IP=192.168.8.11
PUSHPAK_RIG_IP=192.168.8.12
PUSHPAK_ZENOH_PORT=7447
PUSHPAK_DASHBOARD_PORT=5173
PUSHPAK_WEBSOCKET_PORT=8765

PUSHPAK_GROUND_ENDPOINT=tcp/192.168.8.10:7447
PUSHPAK_SCOUT_ENDPOINT=tcp/192.168.8.11:7447
PUSHPAK_RIG_ENDPOINT=tcp/192.168.8.12:7447

export PUSHPAK_SUBNET PUSHPAK_GATEWAY
export PUSHPAK_GROUND_IP PUSHPAK_SCOUT_IP PUSHPAK_RIG_IP
export PUSHPAK_ZENOH_PORT PUSHPAK_DASHBOARD_PORT PUSHPAK_WEBSOCKET_PORT
export PUSHPAK_GROUND_ENDPOINT PUSHPAK_SCOUT_ENDPOINT PUSHPAK_RIG_ENDPOINT
