<?xml version="1.0"?>
<robot name="swarm_drone" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="camera_rate" default="30"/>
  <xacro:arg name="camera_width" default="320"/>
  <xacro:arg name="camera_height" default="240"/>

  <link name="base_link">
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.04"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.4 0.4 0.1"/></geometry>
    </collision>
  </link>

  <link name="camera_link">
    <inertial>
      <mass value="0.05"/> 
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><box size="0.03 0.03 0.03"/></geometry>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 -0.05" rpy="0 1.570796 0"/> 
  </joint>

  <!-- Gazebo Harmonic Native Camera Sensor -->
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>$(arg camera_rate)</update_rate>
      <topic>camera/image</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>$(arg camera_width)</width>
          <height>$(arg camera_height)</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>


  <xacro:macro name="rotor" params="motor_number x_pos y_pos">
    <link name="rotor_${motor_number}_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="0.1" length="0.01"/></geometry>
      </visual>
    </link>
    <joint name="rotor_${motor_number}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rotor_${motor_number}_link"/>
      <origin xyz="${x_pos} ${y_pos} 0.06" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:rotor motor_number="0" x_pos="0.2" y_pos="-0.2"/>  
  <xacro:rotor motor_number="1" x_pos="-0.2" y_pos="0.2"/>  
  <xacro:rotor motor_number="2" x_pos="0.2" y_pos="0.2"/>   
  <xacro:rotor motor_number="3" x_pos="-0.2" y_pos="-0.2"/> 

  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <pose degrees="true">0 0 0 180 0 0</pose>
      <always_on>1</always_on>
      <update_rate>1000.0</update_rate>
    </sensor>
  </gazebo>

  <gazebo reference="base_link">
    <sensor name="ros_imu" type="imu">
      <always_on>1</always_on>
      <update_rate>200</update_rate>
      <topic>swarm_drone/ros_imu</topic>
      <gz_frame_id>base_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>6.91e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>6.91e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>6.91e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>9.01e-3</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>9.01e-3</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>9.71e-3</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <sensor>
        <type>rangefinder</type>
        <index>1</index>
        <topic>swarm_drone/rangefinder/scan</topic>
      </sensor>
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 0</gazeboXYZToNED>
      
      <control channel="0">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>rotor_0_joint</jointName>
        <multiplier>838</multiplier>
      </control>

      <control channel="1">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>rotor_1_joint</jointName>
        <multiplier>838</multiplier>
      </control>

      <control channel="2">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>rotor_2_joint</jointName>
        <multiplier>-838</multiplier> 
      </control>

      <control channel="3">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>rotor_3_joint</jointName>
        <multiplier>-838</multiplier> 
      </control>
    </plugin>
  </gazebo>

  <xacro:macro name="rotor_aero" params="motor_number chirality">
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.00314</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 ${chirality} 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_${motor_number}_link</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.00314</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 ${-1 * chirality} 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_${motor_number}_link</link_name>
    </plugin>
  </xacro:macro>

  <gazebo>
    <xacro:rotor_aero motor_number="0" chirality="1"/>
    <xacro:rotor_aero motor_number="1" chirality="1"/>
    <xacro:rotor_aero motor_number="2" chirality="-1"/>
    <xacro:rotor_aero motor_number="3" chirality="-1"/>
  </gazebo>


  <!-- Downward Rangefinder Link and Sensor (Invariant I-1) -->
  <link name="rangefinder_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="rangefinder_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rangefinder_link"/>
    <origin xyz="0.05 0 -0.05" rpy="0 1.570796 0"/>
  </joint>

  <gazebo reference="rangefinder_link">
    <sensor name="rangefinder_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>swarm_drone/rangefinder/scan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.01</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>


  <gazebo>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/model/swarm_drone/odometry</odom_topic>
      <odom_frame>map</odom_frame>
      <robot_base_frame>swarm_drone/base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>
</robot>