# base_iris.param
# -------------------------------------------------------------
# FRAME CONFIGURATION
# -------------------------------------------------------------
FRAME_CLASS     1      # 1 = Quadcopter
FRAME_TYPE      1      # 1 = X configuration

# -------------------------------------------------------------
# BATTERY SIMULATION (CRITICAL FOR ML TRAINING)
# -------------------------------------------------------------
BATT_MONITOR    4      # 4 = Analog Voltage and Current
BATT_CAPACITY   5000   # Battery capacity in mAh (e.g., 5000mAh)
BATT_VOLT_MAX   25.2   # Max voltage (e.g., 4S LiPo at full charge)
BATT_VOLT_MIN   21.0   # Min safe voltage before critical failsafe
BATT_FS_LOW_ACT 1      # 1 = RTL (Return to Launch) on low battery
BATT_FS_CRT_ACT 2      # 2 = Land on critical battery

# SITL SPECIFIC BATTERY SIMULATION
SIM_BATT_VOLTAGE 25.2  # Starting voltage for the simulator
SIM_BATT_CAP_AH  5.0   # Starting capacity in Amp-Hours

# -------------------------------------------------------------
# HEAVY LIFT & PENDULUM SLUNG LOAD TUNING
# -------------------------------------------------------------
# Lower the Attitude Control P-Gains to prevent violent over-correction
ATC_ANG_PIT_P   3.5    # Default is 4.5. 
ATC_ANG_RLL_P   3.5    # Default is 4.5.

# Increase the D-Gains slightly to dampen the oscillation from the payload
ATC_RAT_PIT_D   0.005
ATC_RAT_RLL_D   0.005

# Motor thrust exponent for larger, heavier propellers (assuming 10-12 inch props)
MOT_THST_EXPO   0.71

# Lower the maximum acceleration to prevent the pendulum from whipping
ATC_ACCEL_P_MAX 80000
ATC_ACCEL_R_MAX 80000

# Increase the hover throttle learning limit since this rig is heavy
MOT_HOVER_LEARN 2

# -------------------------------------------------------------
# VISION NAVIGATION / EKF3 OVERRIDES
# -------------------------------------------------------------
AHRS_EKF_TYPE 3        # Force EKF3 to be the primary estimator

LOG_BACKEND_TYPE 0

SR0_RAW_SENS   10      # IMU
SR0_EXT_STAT   2       # sys status, battery
SR0_RC_CHAN    2
SR0_POSITION   10      # local position
SR0_EXTRA1     10      # attitude
SR0_EXTRA2     10      # VFR HUD
SR0_EXTRA3     2
# -------------------------------------------------------------
# FULL GPS-DENIED AUTONOMOUS NAVIGATION INGESTION
# -------------------------------------------------------------
# SITL Rangefinder 1 Configuration
RNGFND1_TYPE     100
RNGFND1_MIN_CM   10
RNGFND1_MAX_CM   400
RNGFND1_ORIENT   25
RNGFND1_GNDCLEAR 10

# Optical Flow / Vision Speed Estimate EKF3 Fusion
EK3_SRC1_POSZ    2
EK3_SRC1_VELZ    0
GPS_TYPE         0

# Lock SITL to single Gazebo IMU
INS_USE2         0
INS_USE3         0
INS_ENABLE_MASK  1

ARMING_CHECK 1

# === Locked Pure VIO Architecture ===
VISO_TYPE        1
VISO_DELAY_MS    0
EK3_SRC1_POSXY   6
EK3_SRC1_VELXY   6
EK3_SRC1_YAW     6
EK3_CHECK_SCALE  200
COMPASS_USE      0
INS_ACC2OFFS_X 0.0
INS_ACC2OFFS_Y 0.0
INS_ACC2OFFS_Z 0.0
INS_ACC2SCAL_X 1.0
INS_ACC2SCAL_Y 1.0
INS_ACC2SCAL_Z 1.0

# --- EKF Failsafe Configuration (Gate 1.1 Hardening) ---
FS_EKF_ACTION 1
FS_EKF_THRESH    1.0
